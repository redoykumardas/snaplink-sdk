USER_NAME=YOUR_SNAPCHAT_USERNAME
USER_PASSWORD=YOUR_SNAPCHAT_PASSWORD

# Optional session key. If empty, USER_NAME is used.
SNAPCHAT_SESSION_KEY=

# Live smoke test controls.
SNAPCHAT_TEST_LIMIT=100
SNAPCHAT_EXPECT_MIN_FRIENDS=100
SNAPCHAT_TEST_IMAGE=/home/redoy/Documents/Production-line/SnapBot/Redoy-removebg-preview.jpg
SNAPCHAT_TEST_FRIEND_ID=
SNAPCHAT_TEST_MESSAGE=snapchat-sdk live smoke test
SNAPCHAT_TEST_CAPTION=snapchat-sdk live smoke snap
SNAPCHAT_HEADLESS=false

# Real send is disabled unless this is set to 1.
SNAPCHAT_LIVE_SEND=0

# Use one of: bestfriends, groups, friends.
SNAPCHAT_SNAP_TARGET=

# Or send to specific friends from getFriends(), comma separated.
SNAPCHAT_SNAP_FRIEND_IDS=

# Or send to one or more Snapchat shortcut names, comma separated.
SNAPCHAT_SNAP_SHORTCUTS=

# Logout is disabled by default so the saved session stays usable.
SNAPCHAT_LIVE_LOGOUT=0
